  discountAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal @default(0) @db.Decimal(14, 2)
  isServiceCharge     Boolean @default(false)
  remarks             String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([sku])
}

// PO-SOA checks are deliberately separate from SalesDocumentIntake so a review
// retains both original PDFs and its finance decision as one audit record.
model CreditCheckCase {
  id                  String    @id @default(uuid())
  poFileName          String
  poR2ObjectKey       String    @unique
  soaFileName         String
  soaR2ObjectKey      String    @unique
  status              String    @default("UPLOADED")
  recommendation      String?
  poData              Json?
  soaData             Json?
  result              Json?
  justification       String?   @db.Text
  financeRemarks      String?   @db.Text
  financeEvidenceUrl  String?
  financeEvidenceName String?
  bdFollowUpRemarks   String?   @db.Text
  finalDecision       String?
  decidedById         String?
  decidedAt           DateTime?
  uploadedById        String
  aiModel             String?
  errorMessage        String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([recommendation, createdAt])
}

// ============================================================
// SGMP/21/RSR - RETENTION SAMPLE RECORD (Quality Control)
// ============================================================

model RetentionSampleRecord {
  id              String    @id @default(uuid())
  sampleDateTime  DateTime  // Sampling date & time
  sku             String    // Selected SKU (e.g. "425", "800", "425 ML X 24", "800 ML X 12")
  skuLabel        String?   // Snapshot of display label
  amountSample    Int       // Positive integer quantity (e.g. 12, 24)
  batchNo         String    // Batch string preserving leading zeros (e.g. "013526-01")
  preparedById    String    // User who prepared the sample record
  preparedByName  String    // Snapshot of user display name at creation time
  remarks         String?   @db.Text
  
  // Quality Audit & Lifecycle Control
  status          String    @default("ACTIVE") // ACTIVE | VOID
  voidedAt        DateTime?
  voidedById      String?
  voidReason      String?   @db.Text
  
  editedAt        DateTime?
  editedById      String?
  editReason      String?   @db.Text
  
  // Signatures & Verification
  performedSignature String?   @db.Text
  verifiedBy         String?
  verifiedSignature  String?   @db.Text
  verifiedAt         DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  preparedByUser  User      @relation("RetentionSamplePreparer", fields: [preparedById], references: [id])

  @@index([sampleDateTime])
  @@index([batchNo])
  @@index([sku])
  @@index([preparedById])
  @@index([status, sampleDateTime])
}

// ---------------------------------------------------------------------------------------------
// BUSINESS DEVELOPMENT & CUSTOMER CARE COMPLAINTS
// ---------------------------------------------------------------------------------------------

enum ComplaintCategory {
  BOTTLE
  BOTTLE_CAP
  WATER
  OTHER
}

enum ComplaintStatus {
  NEW
  UNDER_INVESTIGATION
  PENDING_QC
  RECALL_INITIATED
  RESOLVED
  CLOSED
}

enum BatchMatchStatus {
  MATCHED
  MULTI_MATCH
  UNMATCHED
  NOT_REPORTED
  MANUAL_OVERRIDE
}

model CustomerComplaint {
  id                    String              @id @default(uuid())
  caseNumber            String              @unique // CC-YYYYMM-XXXX
  companyName           String
  outletName            String?
  contactName           String
  contactPhone          String
  state                 String
  goodsLocationAddress  String              @db.Text
  categories            ComplaintCategory[]
  otherIssueDescription String?             @db.Text
  picDepartment         String              // e.g. "Customer Care", "BD Department", etc.
  status                ComplaintStatus     @default(NEW)
  internalNotes         String?             @db.Text
  
  idempotencyKey        String?             @unique
  externalFormId        String?
  rawPayload            Json?
  
  items                 ComplaintItem[]
  
  createdById           String?
  createdBy             User?               @relation("CustomerComplaintCreator", fields: [createdById], references: [id])
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@index([status, createdAt])
  @@index([companyName])
  @@index([picDepartment])
}

model ComplaintItem {
  id                    String              @id @default(uuid())
  complaintId           String
  productSize           String              // "425ml" or "800ml"
  reportedQtyBottles    Int                 @default(0) // Customer-reported affected bottles (pcs)
  reportedBatchNo       String?
  cleanBatchNo          String?
  
  matchStatus           BatchMatchStatus    @default(UNMATCHED)
  matchedProductionId   String?
  matchRemarks          String?             @db.Text
  
  complaint             CustomerComplaint   @relation(fields: [complaintId], references: [id], onDelete: Cascade)

  @@index([complaintId])
  @@index([cleanBatchNo])
}

enum ManualComplaintPriority {
  GREEN
  YELLOW
  RED
}

enum ManualComplaintStatus {
  OPEN
  ONGOING
  ESCALATED_E3
  CLOSED
}

model ManualComplaintLog {
  id               String                  @id @default(uuid())
  complaintNumber  String                  @unique // CMP-YYYYMM-XXXX
  customerName     String
  customerNumber   String
  customerSocials  String?
  customerPlatform String                  // WhatsApp, TikTok Shop, Shopee, Instagram, Facebook, Call, Website, Other
  
  mainComplaint    String                  @db.Text
  priority         ManualComplaintPriority @default(YELLOW)
  status           ManualComplaintStatus   @default(OPEN)
  picHandling      String
  
  resolutionNotes  String?                 @db.Text
  resolvedAt       DateTime?
  
  createdById      String?
  createdBy        User?                   @relation("ManualComplaintCreator", fields: [createdById], references: [id])
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([status, priority])
  @@index([customerPlatform])
  @@index([picHandling])
  @@index([createdAt])
}

model SocialMediaComplaint {
  id              String   @id @default(uuid())
  complaintId     String   @unique // CMP-TH-001
  date            DateTime
  takenAt         BigInt?
  username        String
  fullName        String?
  customerNumber  String   @default("N/A (Threads)")
  platform        String   @default("Threads")
  postUrl         String?
  categoryGroup   String   @default("General Chatter") // Health Issue, Quality Defect, Inquiry & Refund, General Chatter, Brand Official, Meta AI Assistant
  mainComplaint   String   @db.Text
  rawText         String   @db.Text
  detectedBatchNo String?
  symptoms        String[] @default([])
  priority        String   @default("Medium") // High, Medium, Low, Info
  status          String   @default("Open")   // Open, Ongoing, Closed
  picHandling     String   @default("Unassigned")
  likeCount       Int      @default(0)
  replyCount      Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([categoryGroup])
  @@index([priority, status])
  @@index([platform])
  @@index([detectedBatchNo])
  @@index([date])
}

// ---------------------------------------------------------------------------------------------
// QUALITY CONTROL (QC) - PRODUCT RECALL (SGMP/22/PR)
// ---------------------------------------------------------------------------------------------

model ProductRecall {
  id             String              @id @default(uuid())
  recallNo       String?
  recallDate     DateTime
  reason         String?             @db.Text
  remarks        String?             @db.Text
  preparedById   String?
  preparedByName String
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          ProductRecallItem[]

  @@index([recallDate])
  @@index([createdAt])
  @@index([preparedById])
}

model ProductRecallItem {
  id          String        @id @default(uuid())
  recallId    String
  customer    String
  sku         String
  batchNumber String
  quantity    Int
  remarks     String?       @db.Text

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  recall      ProductRecall @relation(fields: [recallId], references: [id], onDelete: Cascade)

  @@index([recallId])
  @@index([customer])
  @@index([sku])
  @@index([batchNumber])
}

// ==========================================
// NRHO PROJECT MANAGEMENT SYSTEM
// ==========================================

enum NrhoProjectStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum NrhoTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  DELAYED
}

model NrhoProject {
  id                   String            @id @default(uuid())
  projectCode          String            @unique // e.g. NRHO-2026-001
  title                String
  description          String?           @db.Text
  siteLocation         String?
  projectManager       String?
  clientOrDepartment   String?
  status               NrhoProjectStatus @default(DRAFT)
  
  // Approval Flow ("Bentang Kat Boss")
  submittedForApprovalAt DateTime?
  approvedById         String?
  approvedBy           User?             @relation("NrhoProjectApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  approvalRemarks      String?           @db.Text

  startDate            DateTime?
  targetCompletionDate DateTime?
  actualCompletionDate DateTime?

  totalBqAmount        Float             @default(0)
  totalPoAmount        Float             @default(0)
  totalInvoicedAmount  Float             @default(0)

  createdById          String?
  createdBy            User?             @relation("NrhoProjectCreator", fields: [createdById], references: [id])
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  bqItems              NrhoProjectBqItem[]
  tasks                NrhoProjectTask[]
  blueprints           NrhoProjectBlueprint[]
  purchaseOrders       NrhoProjectPO[]
  deliveryOrders       NrhoProjectDO[]
  invoices             NrhoProjectInvoice[]
  auditLogs            NrhoProjectAuditLog[]
  uatSessions          NrhoProjectUat[]
  aiSummary            String?           @db.Text
  aiGeneratedAt        DateTime?

  @@index([status])
  @@index([projectCode])
}

model NrhoProjectBqItem {
  id          String      @id @default(uuid())
  projectId   String
  project     NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  category    String      // e.g. KERJA AWAM, ELEKTRIKAL, KEMASAN
  itemCode    String?
  description String      @db.Text
  quantity    Float       @default(1.0)
  unit        String      @default("UNIT") // M2, M3, LOT, PCS, METER
  unitRate    Float       @default(0.0)
  amount      Float       @default(0.0)
  orderIndex  Int         @default(0)
  createdAt   DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectTask {
  id              String            @id @default(uuid())
  projectId       String
  project         NrhoProject       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskName        String
  description     String?           @db.Text
  assignedTo      String?
  plannedWeek     Int               // e.g. 1 for Week 1
  currentWeek     Int               // active week (when rescheduled)
  startDate       DateTime?
  endDate         DateTime?
  status          NrhoTaskStatus    @default(PENDING)
  progressPercent Int               @default(0)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  rescheduleLogs  NrhoProjectTaskRescheduleLog[]

  @@index([projectId])
  @@index([currentWeek])
}

model NrhoProjectTaskRescheduleLog {
  id          String          @id @default(uuid())
  taskId      String
  task        NrhoProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromWeek    Int
  toWeek      Int
  reason      String          @db.Text
  recordedBy  String
  createdAt   DateTime        @default(now())

  @@index([taskId])
}

model NrhoProjectBlueprint {
  id          String      @id @default(uuid())
  projectId   String
  project     NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  fileUrl     String
  fileType    String      // IMAGE, PDF, CAD
  fileSize    Int?
  uploadedBy  String?
  createdAt   DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectPO {
  id          String      @id @default(uuid())
  projectId   String
  project     NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  poNumber    String
  vendorName  String
  amount      Float
  status      String      @default("ISSUED")
  issueDate   DateTime    @default(now())
  fileUrl     String?
  notes       String?     @db.Text
  createdAt   DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectDO {
  id           String      @id @default(uuid())
  projectId    String
  project      NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  doNumber     String
  vendorName   String
  receivedDate DateTime    @default(now())
  receivedBy   String
  itemsSummary String?     @db.Text
  fileUrl      String?
  notes        String?     @db.Text
  createdAt    DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectInvoice {
  id            String      @id @default(uuid())
  projectId     String
  project       NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invoiceNumber String
  vendorName    String
  amount        Float
  status        String      @default("UNPAID") // UNPAID, PAID
  invoiceDate   DateTime    @default(now())
  dueDate       DateTime?
  fileUrl       String?
  notes         String?     @db.Text
  createdAt     DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectAuditLog {
  id        String      @id @default(uuid())
  projectId String
  project   NrhoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  action    String
  details   String?     @db.Text
  actorName String
  createdAt DateTime    @default(now())

  @@index([projectId])
}

model NrhoProjectUat {
  id              String               @id @default(uuid())
  projectId       String
  project         NrhoProject          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  testerName      String?
  testerPhone     String?
  testerLocation  String?
  testerAddress   String?
  startDate       DateTime?
  endDate         DateTime?
  overallResult   String               @default("PENDING") // PENDING, PASSED, FAILED
  notes           String?              @db.Text
  testedBySign    String?
  testedByDate    DateTime?
  approvedBySign  String?
  approvedByDate  DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  items           NrhoProjectUatItem[]

  @@index([projectId])
}

model NrhoProjectUatItem {
  id                 String          @id @default(uuid())
  uatId              String
  uat                NrhoProjectUat  @relation(fields: [uatId], references: [id], onDelete: Cascade)
  bqItemId           String?
  itemDescription    String          @db.Text
  installationStatus String          @default("COMPLETED") // COMPLETED, IN_PROGRESS, PENDING
  testResult         String          @default("PASS")      // PASS, FAIL, PENDING, NA
  issues             String?         @db.Text
  orderIndex         Int             @default(0)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([uatId])
}

// ---------------------------------------------------------------------------------------------
// ARIA CHATBOT HISTORY
// Saved only for users with the CHATBOT_PRODUCTION module (or superadmin). Each user sees their
// own sessions only.
// ---------------------------------------------------------------------------------------------

model AriaChatSession {
  id        String            @id @default(uuid())
  userId    String
  title     String
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AriaChatMessage[]

  @@index([userId, updatedAt])
}

model AriaChatMessage {
  id        String          @id @default(uuid())
  sessionId String
  role      String // "user" | "bot"
  text      String          @db.Text
  createdAt DateTime        @default(now())
  session   AriaChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}
