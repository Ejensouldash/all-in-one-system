generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                         String                      @id @default(uuid())
  name                       String
  email                      String                      @unique
  password                   String
  role                       Role                        @default(STAFF)
  branchId                   String?
  unitId                     String?
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  modules                    String[]                    @default([])
  googleEmail                String?
  signatureUrl               String?
  signatureUpdatedAt         DateTime?
  dailyReports               DailyReport[]               @relation("DailyReportCreator")
  createdDOs                 DistributionOrder[]         @relation("DOCreator")
  distributionTrackingEvents DistributionTrackingEvent[] @relation("DistributionTrackingActor")
  assignedEvents             Event[]                     @relation("EventAssignee")
  events                     Event[]                     @relation("EventCreator")
  eventInvites               EventAttendee[]
  notices                    Notice[]
  receivedTransfers          ProductionTransfer[]        @relation("TransferReceiver")

  // Handover Relations
  createdHandovers  ProductionHandover[] @relation("HandoverCreator")
  receivedHandovers ProductionHandover[] @relation("HandoverReceiver")

  assignedTickets        Ticket[]                @relation("TicketAssignee")
  tickets                Ticket[]                @relation("TicketCreator")
  assignedMaintenanceTickets MaintenanceTicket[] @relation("MaintenanceTicketAssignee")
  createdMaintenanceTickets  MaintenanceTicket[] @relation("MaintenanceTicketCreator")
  acknowledgedMaintenanceTickets MaintenanceTicket[] @relation("MaintenanceTicketAcknowledger")
  closedMaintenanceTickets       MaintenanceTicket[] @relation("MaintenanceTicketCloser")
  createdNrhoProjects            NrhoProject[]           @relation("NrhoProjectCreator")
  approvedNrhoProjects           NrhoProject[]           @relation("NrhoProjectApprover")
  branch                 Branch?                 @relation(fields: [branchId], references: [id])
  unit                   Unit?                   @relation(fields: [unitId], references: [id])
  openingStocks          WarehouseOpeningStock[] @relation("OpeningStockSetter")
  auditLogs              AuditLog[]
  ariaChatSessions       AriaChatSession[]
  assetAssignments       AssetAssignment[]
  createdReminders       Reminder[]              @relation("ReminderCreator")
  reminderTargets        ReminderRecipient[]     @relation("ReminderTargetUser")
  maintenanceDrafts      MaintenanceFormDraft[]  @relation("MaintenanceDraftOwner")
  uploadedSalesDocuments SalesDocumentIntake[]   @relation("SalesDocumentUploader")
  reviewedSalesDocuments SalesDocumentIntake[]   @relation("SalesDocumentReviewer")
  createdSalesOrders     SalesOrder[]            @relation("SalesOrderCreator")

  // Warehouse Gatepass and returnable-pallet operations are deliberately isolated from
  // ProductionTransfer, WarehouseRawMaterialReport and InventoryBatch.
  createdWarehouseGatePasses WarehouseGatePass[]     @relation("WarehouseGatePassCreator")
  gatePassStatusEvents       GatePassStatusEvent[]   @relation("GatePassStatusActor")
  linkedGatePassDOs          GatePassDeliveryOrder[] @relation("GatePassDOLinker")
  createdPalletTransfers     PalletTransfer[]        @relation("PalletTransferCreator")
  verifiedPalletTransfers    PalletTransfer[]        @relation("PalletTransferVerifier")
  postedPalletTransfers      PalletTransfer[]        @relation("PalletTransferPoster")
  reversedPalletTransfers    PalletTransfer[]        @relation("PalletTransferReverser")
  createdPalletMovements     PalletMovement[]        @relation("PalletMovementCreator")
  recordedPhysicalPalletEvents PhysicalPalletEvent[]
  retentionSampleRecords     RetentionSampleRecord[] @relation("RetentionSamplePreparer")
  customerComplaints         CustomerComplaint[]     @relation("CustomerComplaintCreator")
  manualComplaints           ManualComplaintLog[]    @relation("ManualComplaintCreator")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]
  users     User[]
}

model Unit {
  id        String     @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tickets   Ticket[]
  branch    Branch     @relation(fields: [branchId], references: [id])
  users     User[]
  reminders Reminder[]
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum AssetType {
  IT_EQUIPMENT
  VEHICLE
  MACHINERY
  FURNITURE
  SAFETY
  OTHER
  // New standardized categories
  ICT_EQUIPMENT
  OFFICE_EQUIPMENT
  EVENT_EQUIPMENT
  TOOLS
  SAFETY_EQUIPMENT
  MACHINE
  ELECTRICAL_EQUIPMENT
}

model Department {
  id     String  @id @default(uuid())
  name   String  @unique
  code   String? @unique
  assets Asset[]
}

model Location {
  id     String  @id @default(uuid())
  name   String
  block  String?
  state  String?
  city   String?
  assets Asset[]
}

model Asset {
  id           String  @id @default(uuid())
  assetTag     String  @unique
  name         String
  brand        String?
  model        String?
  serialNumber String?
  deviceId     String?
  description  String? @db.Text

  condition    String?
  imageUrl     String?

  type   AssetType   @default(OTHER)
  status AssetStatus @default(AVAILABLE)

  purchaseDate DateTime? @db.Date
  price        Float?
  supplier     String?
  warrantyInfo String?

  plateNumber String?

  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])

  locationId String?
  location   Location? @relation(fields: [locationId], references: [id])

  assignments AssetAssignment[]
  maintenance MaintenanceLog[]
  tickets     Ticket[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AssetAssignment {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id])

  checkoutDate DateTime  @default(now())
  returnDate   DateTime?
  remarks      String?
}

model MaintenanceLog {
  id      String @id @default(uuid())
  assetId String
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  date        DateTime @default(now())
  cost        Float?
  vendor      String?
  description String
  resolution  String?
}

model Ticket {
  id            String       @id @default(uuid())
  title         String
  description   String
  status        TicketStatus @default(OPEN)
  priority      String       @default("Low")
  createdById   String
  unitId        String?
  location      String?
  linkedAssetId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assetNumber   String?
  assetType     String?
  assigneeId    String?
  internalNotes String?
  phone         String?
  resolution    String?
  rootCause     String?
  requesterName String?
  ticketNumber  Int          @unique @default(autoincrement())
  slaBreached   Boolean      @default(false)
  slaDeadline   DateTime?
  type          String?
  typeOthers    String?
  assignee      User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy     User         @relation("TicketCreator", fields: [createdById], references: [id])
  linkedAsset   Asset?       @relation(fields: [linkedAssetId], references: [id])
  unit          Unit?        @relation(fields: [unitId], references: [id])
  costs         TicketCost[]
}

enum MaintenanceTicketType {
  MECHANICAL
  CIVIL
  ELECTRICAL
  OTHERS
}

enum MaintenanceTicketStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  AWAITING_VERIFICATION
  AWAITING_COSTING
  COMPLETED
  CLOSED
  CANCELLED
  REJECTED
}

enum MaintenanceTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenancePhotoCategory {
  INITIAL_COMPLAINT
  BEFORE
  PROGRESS
  AFTER
}

enum MaintenanceCostCategory {
  SPARE_PART
  LABOUR
  CONTRACTOR
  OTHER
}

model MaintenanceTicket {
  id              String                    @id @default(uuid())
  ticketNumber    Int                       @unique @default(autoincrement())
  legacyProjectId String?                   // e.g. P0226-01 from old Excel
  
  title           String                    // Work Description
  reasonOfWork    String?                   @db.Text
  ticketType      MaintenanceTicketType     @default(MECHANICAL)
  priority        MaintenanceTicketPriority @default(MEDIUM)
  status          MaintenanceTicketStatus   @default(OPEN)
  
  location        String                    // KAR, KBP Block A, B, C, D, etc.
  specificArea    String?                   // e.g. Rotary machine BM3, changing room
  
  requesterName   String
  requesterPhone  String
  requesterEmail  String?
  requesterToken  String?                   @unique
  createdById     String?                   // Nullable for unauthenticated public submissions
  createdBy       User?                     @relation("MaintenanceTicketCreator", fields: [createdById], references: [id])
  
  // PIC Accountability
  acknowledgedById   String?
  acknowledgedBy     User?                  @relation("MaintenanceTicketAcknowledger", fields: [acknowledgedById], references: [id])
  acknowledgedAt     DateTime?
  picAgreement       Boolean                @default(false)
  
  // Assignment
  assigneeId      String?
  assignee        User?                     @relation("MaintenanceTicketAssignee", fields: [assigneeId], references: [id])
  assigneeName    String?                   // Text fallback for external contractors / legacy PICs (e.g. Ridzuan, Akmal)
  contractorToken String?                   @unique
  contractorPhone String?
  contractorEmail String?
  
  // High-precision Scheduling
  targetStartDate DateTime?
  targetDateline  DateTime?
  estimatedDays   Float?
  startedAt       DateTime?
  workCompletedAt DateTime?
  completedAt     DateTime?                 // Kept for backward compatibility
  closedAt        DateTime?
  
  kpiDays         Int?                      @default(0) // Legacy
  kpiResponseMins Int?
  kpiRepairHours  Float?
  kpiStatus       String?                   // "On Time", "Delay", "In progress"
  
  rootCause       String?                   @db.Text
  resolution      String?                   @db.Text
  internalNotes   String?                   @db.Text
  noPhotoReason   String?
  verifiedBy      String?
  handover        String?
  
  // Requester Acceptance & Verification
  verifiedByRequester Boolean               @default(false)
  requesterFeedback   String?
  requesterVerifiedAt DateTime?
  
  // Closure
  closedById      String?
  closedBy        User?                     @relation("MaintenanceTicketCloser", fields: [closedById], references: [id])
  jobSheetNumber  String?                   @unique
  jobSheetPdfUrl  String?
  technicianSignature String?               @db.Text
  requesterSignature  String?               @db.Text
  picSignature        String?               @db.Text
  
  photoUrl        String?                   // Cloudflare R2 path or public URL (Legacy / complaint preview)
  requestPdfUrl   String?                   // Cloudflare R2 path or public URL for uploaded intake PDF/memo
  requestPdfName  String?                   // Original filename of uploaded PDF
  
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  
  costs           MaintenanceTicketCost[]
  photos          MaintenanceTicketPhoto[]
  activityLogs    MaintenanceActivityLog[]
  purchaseRequests MaintenancePurchaseRequest[]

  @@index([status])
  @@index([ticketType])
  @@index([createdAt])
  @@index([requesterToken])
  @@index([contractorToken])
}

model MaintenanceTicketPhoto {
  id              String                   @id @default(uuid())
  ticketId        String
  ticket          MaintenanceTicket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category        MaintenancePhotoCategory
  objectKey       String
  fileUrl         String
  fileName        String
  fileSize        Int?
  mimeType        String                   @default("image/jpeg")
  caption         String?
  uploadedByName  String?
  createdAt       DateTime                 @default(now())

  @@index([ticketId])
  @@index([category])
}

model MaintenanceTicketCost {
  id          String                  @id @default(uuid())
  ticketId    String
  ticket      MaintenanceTicket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  category    MaintenanceCostCategory @default(SPARE_PART)
  itemId      String?
  itemName    String
  quantity    Float                   @default(1.0)
  unit        String                  @default("PCS")
  unitPrice   Float                   @default(0.0)
  amount      Float
  remarks     String?
  createdAt   DateTime                @default(now())

  @@index([ticketId])
}

model MaintenanceActivityLog {
  id          String            @id @default(uuid())
  ticketId    String
  ticket      MaintenanceTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorName   String
  actorRole   String
  action      String
  details     String?           @db.Text
  isPublic    Boolean           @default(false)
  createdAt   DateTime          @default(now())

  @@index([ticketId])
}

model MaintenanceNotificationRecipient {
  id          String                 @id @default(uuid())
  name        String
  email       String
  ticketType  MaintenanceTicketType? // null means ALL ticket types
  isEnabled   Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([isEnabled])
  @@index([ticketType])
}

model MaintenanceNotificationOutbox {
  id          String    @id @default(uuid())
  ticketId    String?
  to          String
  subject     String
  html        String    @db.Text
  status      String    @default("PENDING") // PENDING, SENT, FAILED
  error       String?   @db.Text
  attempts    Int       @default(0)
  sentAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
}


model Event {
  id            String          @id @default(uuid())
  title         String
  description   String?
  startDateTime DateTime
  endDateTime   DateTime
  assigneeId    String?
  createdById   String
  googleEventId String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  assignee      User?           @relation("EventAssignee", fields: [assigneeId], references: [id])
  createdBy     User            @relation("EventCreator", fields: [createdById], references: [id])
  attendees     EventAttendee[]
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("PENDING") // PENDING | GOING | MAYBE | DECLINED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model TransferIn {
  id           String           @id @default(uuid())
  receiveDate  DateTime         @db.Date
  receiveTime  String
  shift        String           @default("AM")
  doNumber     String
  receiverName String
  createdAt    DateTime         @default(now())
  items        TransferInItem[]
}

model TransferInItem {
  id           String     @id @default(uuid())
  transferInId String
  category     String
  batchNo      String
  bags         Int
  mult         Int
  transferIn   TransferIn @relation(fields: [transferInId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                  String               @id @default(uuid())
  date                DateTime             @db.Date
  shift               String
  line                String
  preparedBy          String
  verifiedBy          String
  remarks             String?
  createdAt           DateTime             @default(now())
  status              String               @default("PENDING")
  noProduction        Boolean              @default(false)
  preparedSignature   String?
  verifiedSignature   String?
  time                String?
  reportTime          String?
  approvedAt          DateTime?
  createdById         String?
  totalManpower       Int?
  maxTotalManpower    Int?
  breakdowns          BreakdownLog[]
  createdBy           User?                @relation("DailyReportCreator", fields: [createdById], references: [id])
  inventory           InventoryLog[]
  productions         ProductionOutput[]
  productionTransfers ProductionTransfer[]
  productionHandovers ProductionHandover[]
  rejects             RejectLog[]
  holds               ProductionHoldItem[]
}

model ProductionHoldItem {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  batchNo    String
  qty        Float
  mult       Int         @default(1)
  reason     String
  status     String      @default("PENDING") // PENDING, REJECT_BEFORE, REJECT_AFTER, REUSE, RETURN
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  resolvedAt DateTime?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionOutput {
  id          String            @id @default(uuid())
  reportId    String
  productType String
  totalBox    Int
  batches     ProductionBatch[]
  report      DailyReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionBatch {
  id                 String           @id @default(uuid())
  productionOutputId String
  batchNo            String
  qty                Int
  type               String
  otherType          String?
  productionOutput   ProductionOutput @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)
}

model RejectLog {
  id       String      @id @default(uuid())
  reportId String
  item     String
  before   Int
  after    Int
  type     String      @default("SCRAP")
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model BreakdownLog {
  id       String      @id @default(uuid())
  reportId String
  section  String
  downtime Int
  reason   String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  type       String
  period     String?
  batchNo    String
  bags       Float
  mult       Int
  labelType  String?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CostCatalog {
  id          String   @id @default(uuid())
  itemName    String
  description String?
  defaultCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketCost {
  id        String   @id @default(uuid())
  ticketId  String
  itemName  String
  amount    Float
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notice {
  id             String   @id @default(uuid())
  message        String
  type           String   @default("NORMAL")
  targetAudience String   @default("ALL")
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation(fields: [createdById], references: [id])
}

model ProductionTransfer {
  id            String         @id @default(uuid())
  dailyReportId String?
  sku           String
  batchNumber   String
  qtyProduced   Int
  status        TransferStatus @default(PENDING)
  receivedById  String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dailyReport   DailyReport?   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  receivedBy    User?          @relation("TransferReceiver", fields: [receivedById], references: [id])
}

model ProductionHandover {
  id             String   @id @default(uuid())
  handoverNumber String   @unique
  date           DateTime

  dailyReportId String
  dailyReport   DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)

  productionStaffId String
  productionStaff   User    @relation("HandoverCreator", fields: [productionStaffId], references: [id])
  productionSign    String? // Digital signature of production staff

  warehouseStaffId String? // Nullable until signed
  warehouseStaff   User?   @relation("HandoverReceiver", fields: [warehouseStaffId], references: [id])
  warehouseSign    String? // Digital signature of warehouse staff

  status    String   @default("PENDING") // PENDING, ACKNOWLEDGED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items HandoverItem[]
}

model HandoverItem {
  id               String @id @default(uuid())
  handoverId       String
  category         String
  batchNo          String
  type             String @default("Standard")
  totalProducedPcs Int

  // Deductions
  deductions HandoverDeduction[]

  // Final to warehouse
  netToWarehousePcs Int

  handover ProductionHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model HandoverDeduction {
  id             String  @id @default(uuid())
  handoverItemId String
  destination    String // e.g. "Budak Tahfiz", "Staff Purchase"
  qtyPcs         Int
  remarks        String?

  handoverItem HandoverItem @relation(fields: [handoverItemId], references: [id], onDelete: Cascade)
}

model InventoryBatch {
  id               String   @id @default(uuid())
  batchNumber      String
  sku              String
  totalQtyIn       Int      @default(0)
  totalQtyOut      Int      @default(0)
  availableBalance Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sku, batchNumber])
}

model DistributionOrder {
  id                 String                      @id @default(uuid())
  doNumber           String                      @unique
  distributionDate   DateTime
  destination        String
  vehicleNo          String?
  driverName         String?
  status             DOStatus                    @default(PREPARING)
  createdById        String
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  sponsorshipDetails String?
  distributionMethod String
  items              DOLineItem[]
  createdBy          User                        @relation("DOCreator", fields: [createdById], references: [id])
  returns            GoodsReturnNote[]
  trackingEvents     DistributionTrackingEvent[]
  gatePassLinks      GatePassDeliveryOrder[]
  palletTransfers    PalletTransfer[]
  physicalPallets    PhysicalPallet[] @relation("CurrentPalletDO")
  physicalPalletEvents PhysicalPalletEvent[]
}

// Append-only delivery milestones. These records enrich warehouse traceability without changing
// production, inventory balance, handover, distribution deduction, or return calculations.
model DistributionTrackingEvent {
  id                  String   @id @default(uuid())
  distributionOrderId String
  eventType           String
  latitude            Float?
  longitude           Float?
  accuracy            Float?
  locationStatus      String   @default("UNAVAILABLE")
  remarks             String?  @db.Text
  recordedById        String
  recordedAt          DateTime @default(now())

  distributionOrder DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
  recordedBy        User              @relation("DistributionTrackingActor", fields: [recordedById], references: [id])

  @@index([distributionOrderId, recordedAt])
  @@index([eventType, recordedAt])
}

model DOLineItem {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtySent             Int
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model GoodsReturnNote {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtyReturned         Int
  reason              ReturnReason
  status              ReturnStatus      @default(QUARANTINE)
  loggedAt            DateTime          @default(now())
  restockedAt         DateTime?
  restockedBy         String?
  restockedSignature  String?
  restockedReason     String?
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model WarehouseOpeningStock {
  id          String   @id @default(uuid())
  batchNumber String
  sku         String
  openingQty  Int
  month       Int
  year        Int
  setById     String
  createdAt   DateTime @default(now())
  setBy       User     @relation("OpeningStockSetter", fields: [setById], references: [id])

  @@unique([sku, batchNumber, month, year])
}

enum Role {
  SUPERADMIN
  STAFF
  SUPERVISOR
}

enum Status {
  ACTIVE
  BROKEN
  MAINTENANCE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TransferStatus {
  PENDING
  RECEIVED
}

enum DOStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum GatePassStatus {
  DRAFT
  AWAITING_CUSTOMER
  CUSTOMER_SUBMITTED
  WAREHOUSE_ACKNOWLEDGED
  PREPARING
  READY_FOR_PICKUP
  CHECKED_IN
  LOADING
  CHECKED_OUT
  COMPLETED
  EXPIRED
  CANCELLED
  REJECTED
  NO_SHOW
}

enum GatePassActorType {
  INTERNAL_USER
  EXTERNAL_CUSTOMER
  SYSTEM
}

enum PalletTransferStatus {
  DRAFT
  POSTED
  REVERSED
}

enum PalletMovementType {
  OPENING_BALANCE
  ISSUE_OUT
  RETURN_IN
  TRANSFER
  DAMAGE_RETURN
  LOST_WRITE_OFF
  ADJUSTMENT_IN
  ADJUSTMENT_OUT
  REVERSAL
}

enum PalletCondition {
  USABLE
  DAMAGED
  LOST
}

enum PhysicalPalletStatus {
  IN_WAREHOUSE
  WITH_CUSTOMER
  RETURNED
  DAMAGED
  LOST
}

enum PalletCustodianKind {
  SYSTEM_OPENING
  WAREHOUSE_USABLE
  WAREHOUSE_DAMAGED
  CUSTOMER
  TRANSPORTER
  WRITTEN_OFF
}

enum ReturnReason {
  DAMAGE
  WRONG_PO
  DELIVERY_FAIL
}

enum ReturnStatus {
  QUARANTINE
  SCRAP
  REPACKED
  RESTOCKED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ---------------------------------------------------------------------------------------------
// WAREHOUSE GATEPASS AND RETURNABLE PALLET LEDGER
// These planning and asset-ledger records never mutate product/raw-material inventory.
// ---------------------------------------------------------------------------------------------

model WarehouseGatePass {
  id                      String         @id @default(uuid())
  gatePassNo              String         @unique
  status                  GatePassStatus @default(DRAFT)
  purpose                 String
  requestedPickupAt       DateTime
  pickupLocation          String
  destination             String
  customerName            String
  customerContactName     String?
  customerContactEmail    String?
  customerContactPhone    String?
  customerReference       String?
  plannedPalletQty        Int            @default(0)
  actualPalletQty         Int?
  transportCompany        String?
  driverName              String?
  driverPhone             String?
  vehicleNo               String?
  vehicleType             String?
  checkedInVehicleNo      String?
  checkedInDriverName     String?
  confirmedEta            DateTime?
  internalRemarks         String?        @db.Text
  customerRemarks         String?        @db.Text
  warehouseRemarks        String?        @db.Text
  securityRemarks         String?        @db.Text
  cancellationReason      String?        @db.Text
  rejectionReason         String?        @db.Text
  createdById             String
  customerSubmittedAt     DateTime?
  warehouseAcknowledgedAt DateTime?
  readyAt                 DateTime?
  checkedInAt             DateTime?
  loadingStartedAt        DateTime?
  loadingCompletedAt      DateTime?
  checkedOutAt            DateTime?
  completedAt             DateTime?
  cancelledAt             DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  createdBy          User                        @relation("WarehouseGatePassCreator", fields: [createdById], references: [id])
  items              WarehouseGatePassItem[]
  externalTokens     GatePassExternalToken[]
  verificationTokens GatePassVerificationToken[]
  statusEvents       GatePassStatusEvent[]
  deliveryOrders     GatePassDeliveryOrder[]
  palletTransfers    PalletTransfer[]
  physicalPallets    PhysicalPallet[] @relation("CurrentPalletGatePass")
  physicalPalletEvents PhysicalPalletEvent[]

  @@index([status, requestedPickupAt])
  @@index([customerName])
  @@index([vehicleNo])
  @@index([createdById, createdAt])
}

model WarehouseGatePassItem {
  id             String  @id @default(uuid())
  gatePassId     String
  sku            String?
  description    String
  uom            String  @default("BOX")
  plannedQty     Int
  actualQty      Int?
  varianceReason String? @db.Text
  sortOrder      Int     @default(0)

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, sortOrder])
}

model GatePassExternalToken {
  id          String    @id @default(uuid())
  gatePassId  String
  tokenHash   String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  submittedAt DateTime?
  createdAt   DateTime  @default(now())

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, createdAt])
  @@index([expiresAt])
}

model GatePassVerificationToken {
  id         String    @id @default(uuid())
  gatePassId String
  publicCode String    @unique
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  gatePass WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)

  @@index([gatePassId, createdAt])
}

model GatePassStatusEvent {
  id          String            @id @default(uuid())
  gatePassId  String
  fromStatus  GatePassStatus?
  toStatus    GatePassStatus
  actorType   GatePassActorType
  actorUserId String?
  actorLabel  String?
  remarks     String?           @db.Text
  ipAddress   String?
  userAgent   String?           @db.Text
  occurredAt  DateTime          @default(now())

  gatePass  WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  actorUser User?             @relation("GatePassStatusActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([gatePassId, occurredAt])
  @@index([actorUserId])
}

model GatePassDeliveryOrder {
  gatePassId          String
  distributionOrderId String
  isPrimary           Boolean  @default(false)
  linkedById          String
  linkedAt            DateTime @default(now())

  gatePass          WarehouseGatePass @relation(fields: [gatePassId], references: [id], onDelete: Cascade)
  distributionOrder DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
  linkedBy          User              @relation("GatePassDOLinker", fields: [linkedById], references: [id])

  @@id([gatePassId, distributionOrderId])
  @@index([distributionOrderId])
  @@index([linkedById])
}

model PalletType {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  material  String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transferLines PalletTransferLine[]
  movements     PalletMovement[]
  physicalPallets PhysicalPallet[]
}

// Individually labelled returnable assets.  The aggregate ledger remains the financial/quantity
// source of truth while this table gives operations a scan-friendly physical location history.
model PhysicalPallet {
  id                  String               @id @default(uuid())
  palletCode          String               @unique
  palletTypeId        String
  status              PhysicalPalletStatus @default(IN_WAREHOUSE)
  condition           PalletCondition      @default(USABLE)
  currentCustodianId  String?
  currentGatePassId   String?
  currentDOId         String?
  lastMovedAt         DateTime             @default(now())
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  palletType       PalletType          @relation(fields: [palletTypeId], references: [id])
  currentCustodian PalletCustodian?    @relation(fields: [currentCustodianId], references: [id])
  currentGatePass  WarehouseGatePass?  @relation("CurrentPalletGatePass", fields: [currentGatePassId], references: [id])
  currentDO        DistributionOrder?  @relation("CurrentPalletDO", fields: [currentDOId], references: [id])
  events           PhysicalPalletEvent[]

  @@index([status, currentCustodianId])
  @@index([palletTypeId])
}

model PhysicalPalletEvent {
  id                String   @id @default(uuid())
  physicalPalletId  String
  eventType         String
  fromCustodianId   String?
  toCustodianId     String?
  gatePassId        String?
  distributionOrderId String?
  remarks           String?  @db.Text
  recordedById      String
  occurredAt        DateTime @default(now())

  physicalPallet PhysicalPallet @relation(fields: [physicalPalletId], references: [id], onDelete: Cascade)
  fromCustodian  PalletCustodian? @relation("PhysicalPalletEventFrom", fields: [fromCustodianId], references: [id])
  toCustodian    PalletCustodian? @relation("PhysicalPalletEventTo", fields: [toCustodianId], references: [id])
  gatePass       WarehouseGatePass? @relation(fields: [gatePassId], references: [id])
  distributionOrder DistributionOrder? @relation(fields: [distributionOrderId], references: [id])
  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([physicalPalletId, occurredAt])
}

model PalletCustodian {
  id                String              @id @default(uuid())
  kind              PalletCustodianKind
  name              String
  externalReference String?
  active            Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  outgoingTransfers PalletTransfer[] @relation("PalletTransferFromCustodian")
  incomingTransfers PalletTransfer[] @relation("PalletTransferToCustodian")
  outgoingMovements PalletMovement[] @relation("PalletMovementFromCustodian")
  incomingMovements PalletMovement[] @relation("PalletMovementToCustodian")
  currentPhysicalPallets PhysicalPallet[]
  physicalPalletEventsFrom PhysicalPalletEvent[] @relation("PhysicalPalletEventFrom")
  physicalPalletEventsTo PhysicalPalletEvent[] @relation("PhysicalPalletEventTo")

  @@unique([kind, name])
  @@index([kind, active])
}

model PalletTransfer {
  id                  String               @id @default(uuid())
  transferNo          String               @unique
  status              PalletTransferStatus @default(DRAFT)
  movementType        PalletMovementType
  gatePassId          String?
  distributionOrderId String?
  occurredAt          DateTime
  fromCustodianId     String
  toCustodianId       String
  transportCompany    String?
  driverName          String?
  vehicleNo           String?
  remarks             String?              @db.Text
  evidenceUrl         String?
  releasedSignature   String?              @db.Text
  receivedByName      String?
  receivedSignature   String?              @db.Text
  verifiedSignature   String?              @db.Text
  createdById         String
  verifiedById        String?
  postedById          String?
  postedAt            DateTime?
  reversedById        String?
  reversedAt          DateTime?
  reversalReason      String?              @db.Text
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  gatePass          WarehouseGatePass?   @relation(fields: [gatePassId], references: [id], onDelete: SetNull)
  distributionOrder DistributionOrder?   @relation(fields: [distributionOrderId], references: [id], onDelete: SetNull)
  fromCustodian     PalletCustodian      @relation("PalletTransferFromCustodian", fields: [fromCustodianId], references: [id])
  toCustodian       PalletCustodian      @relation("PalletTransferToCustodian", fields: [toCustodianId], references: [id])
  createdBy         User                 @relation("PalletTransferCreator", fields: [createdById], references: [id])
  verifiedBy        User?                @relation("PalletTransferVerifier", fields: [verifiedById], references: [id], onDelete: SetNull)
  postedBy          User?                @relation("PalletTransferPoster", fields: [postedById], references: [id], onDelete: SetNull)
  reversedBy        User?                @relation("PalletTransferReverser", fields: [reversedById], references: [id], onDelete: SetNull)
  lines             PalletTransferLine[]
  movements         PalletMovement[]

  @@index([status, occurredAt])
  @@index([gatePassId])
  @@index([distributionOrderId])
  @@index([fromCustodianId])
  @@index([toCustodianId])
}

model PalletTransferLine {
  id            String          @id @default(uuid())
  transferId    String
  palletTypeId  String
  quantity      Int
  fromCondition PalletCondition @default(USABLE)
  toCondition   PalletCondition @default(USABLE)
  remarks       String?         @db.Text

  transfer   PalletTransfer   @relation(fields: [transferId], references: [id], onDelete: Cascade)
  palletType PalletType       @relation(fields: [palletTypeId], references: [id])
  movements  PalletMovement[]

  @@index([transferId])
  @@index([palletTypeId])
}

model PalletMovement {
  id                 String             @id @default(uuid())
  transferId         String
  transferLineId     String
  palletTypeId       String
  movementType       PalletMovementType
  fromCustodianId    String
  toCustodianId      String
  quantity           Int
  reversesMovementId String?
  createdById        String
  createdAt          DateTime           @default(now())

  transfer            PalletTransfer     @relation(fields: [transferId], references: [id], onDelete: Restrict)
  transferLine        PalletTransferLine @relation(fields: [transferLineId], references: [id], onDelete: Restrict)
  palletType          PalletType         @relation(fields: [palletTypeId], references: [id])
  fromCustodian       PalletCustodian    @relation("PalletMovementFromCustodian", fields: [fromCustodianId], references: [id])
  toCustodian         PalletCustodian    @relation("PalletMovementToCustodian", fields: [toCustodianId], references: [id])
  reversesMovement    PalletMovement?    @relation("PalletMovementReversal", fields: [reversesMovementId], references: [id])
  reversedByMovements PalletMovement[]   @relation("PalletMovementReversal")
  createdBy           User               @relation("PalletMovementCreator", fields: [createdById], references: [id])

  @@index([transferId])
  @@index([palletTypeId, createdAt])
  @@index([fromCustodianId, palletTypeId])
  @@index([toCustodianId, palletTypeId])
  @@index([reversesMovementId])
}

