// ---------------------------------------------------------------------------------------------
// Daily Raw Material (Warehouse) — form SGMP/15/DRM (W)
//
// A warehouse-side ledger, deliberately separate from the production storeroom replay in
// getActiveInventory. Each report reads its opening balance from the previous report's carry
// forward, so this is a simple lookup rather than a fourth carry-forward calculation.
//
// On submit, rows with a stock-out quantity also generate a TransferIn document, which is how the
// figure reaches the Daily Production Report without any production code being changed.
// ---------------------------------------------------------------------------------------------

model WarehouseRawMaterialReport {
  id                String   @id @default(uuid())
  date              DateTime @db.Date
  time              String
  shift             String   @default("AM") // "AM" | "PM"
  sequence          Int // 1, 2, 3... order of the chain within one date
  preparedBy        String
  preparedSignature String?
  verifiedBy        String?
  verifiedSignature String?
  remarks           String?
  createdById       String?
  linkedDoNumber    String? // the TransferIn DO generated from this report's stock-out rows
  referenceDoNumber String? // QC reference only; does not drive the generated TransferIn DO
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // SGMP-15 is a controlled GMP document, so a mistaken entry is voided rather than erased.
  // A voided report keeps all its rows but is skipped by the carry-forward chain, and its
  // generated DO is removed.
  status     String    @default("ACTIVE") // "ACTIVE" | "VOID"
  voidedAt   DateTime?
  voidedById String?
  voidReason String?

  items WarehouseRawMaterialItem[]

  @@index([date, sequence])
}

model WarehouseRawMaterialItem {
  id           String  @id @default(uuid())
  reportId     String
  sku          String // catalogue key, e.g. "BOTTLE 425ml X181"
  category     String // Transfer In category, e.g. "BOTTLE 425ml"
  mult         Int
  batchNo      String
  balanceIn    Float   @default(0)
  qtyIn        Float   @default(0)
  qtyOut       Float   @default(0)
  carryForward Float   @default(0)
  remarks      String?

  report WarehouseRawMaterialReport @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
}

// ---------------------------------------------------------------------------------------------
// Raw material withdrawal — warehouse to production
//
// Production helps itself from the warehouse rack, so warehouse staff cannot know the outflow.
// Whoever physically moves the stock records it here instead, and the Daily Raw Material form's
// QUANTITY STOCK OUT is derived from these records rather than typed.
//
// A PRODUCTION withdrawal generates a TransferIn document immediately, which is how it reaches
// the Daily Production Report without any production code being changed. Other purposes reduce
// the warehouse balance without sending anything to production.
// ---------------------------------------------------------------------------------------------

model RawMaterialWithdrawal {
  id             String    @id @default(uuid())
  withdrawalNo   String    @unique // WD-260730-001
  date           DateTime  @db.Date
  time           String
  shift          String    @default("AM") // "AM" | "PM"
  takenBy        String
  purpose        String    @default("PRODUCTION") // PRODUCTION | DISPOSAL | RETURN | ADJUSTMENT
  remarks        String?
  // Non-null means this was recorded after the fact. `date` and the linked DO's receiveDate remain
  // the day the material left the rack; createdAt records when staff entered it into the system.
  backdateReason String?
  createdById    String?
  linkedDoNumber String? // the TransferIn DO generated, PRODUCTION purpose only
  status         String    @default("ACTIVE") // "ACTIVE" | "VOID"
  voidedAt       DateTime?
  voidedById     String?
  voidReason     String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  items RawMaterialWithdrawalItem[]

  @@index([createdAt])
  @@index([date, status])
}

model RawMaterialWithdrawalItem {
  id           String @id @default(uuid())
  withdrawalId String
  sku          String // catalogue key, e.g. "BOX 425x24"
  category     String // Transfer In category
  mult         Int
  batchNo      String
  qty          Float

  withdrawal RawMaterialWithdrawal @relation(fields: [withdrawalId], references: [id], onDelete: Cascade)

  @@index([withdrawalId])
  @@index([batchNo])
}

// ---------------------------------------------------------------------------------------------
// GMP (Maintenance) FORM DRAFTS
// Generic "save as draft" store for the SGMP forms under /forms/maintenance.
// Kept in its own table on purpose: the 27 submitted-record models stay untouched, so drafts can
// never leak into summaries or reports.
// ---------------------------------------------------------------------------------------------

model MaintenanceFormDraft {
  id        String   @id @default(uuid())
  formType  String // route slug, e.g. "qcdr", "dqip", "cleaning:packing"
  userId    String
  payload   Json // snapshot of the form state, signatures excluded
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation("MaintenanceDraftOwner", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([formType, userId])
  @@index([userId])
}

// ---------------------------------------------------------------------------------------------
// SALES ORDERING
// Commercial order intake is intentionally isolated from Production and Warehouse inventory.
// A Sales Order never mutates InventoryBatch; stock remains controlled by DistributionOrder.
// ---------------------------------------------------------------------------------------------

model Customer {
  id                    String   @id @default(uuid())
  customerCode          String   @unique
  sageCustomerId        String?
  legalName             String
  tradingName           String?
  pic                   String?
  email                 String?
  phonePrimary          String?
  phoneSecondary        String?
  customerType          String?
  customerSubtype       String?
  categoryCode          String?
  zone                  String?
  region                String?
  creditTermsRaw        String?
  creditTermDays        Int?
  paymentPolicy         String?
  salesRep1             String?
  salesRep2             String?
  companyRegistrationNo String?
  tinNo                 String?
  sstNo                 String?
  importStatus          String   @default("READY")
  sourceData            Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  addresses       CustomerAddress[]
  documentIntakes SalesDocumentIntake[]
  salesOrders     SalesOrder[]
  registrations   CustomerRegistration[]

  @@index([sageCustomerId])
  @@index([legalName])
  @@index([customerType, customerSubtype])
  @@index([zone])
}

model CustomerRegistration {
  id                       String  @id @default(uuid())
  registrationNo           String  @unique
  idempotencyKey           String? @unique
  companyName              String
  companyRegNoNew          String?
  companyRegNoOld          String?
  tinNo                    String?
  sstNo                    String?
  businessType             String?
  natureOfBusiness         String?
  businessAddress          String? @db.Text
  registeredAddress        String? @db.Text
  businessCommencementDate String?
  annualTurnover           String?
  paidUpCapital            String?
  contactOffice            String?
  contactFax               String?
  emailInvoice             String?
  msicCode                 String?

  contacts            Json?
  financial           Json?
  tradeReferences     Json?
  directors           Json?
  supportingDocuments Json?
  guarantors          Json?

  status            String    @default("PENDING")
  rejectionReason   String?
  createdCustomerId String?
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  createdCustomer Customer? @relation(fields: [createdCustomerId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([companyName])
  @@index([idempotencyKey])
}

model CustomerAddress {
  id                 String   @id @default(uuid())
  customerId         String
  addressType        String   @default("BILLING")
  label              String   @default("Master Address")
  attentionTo        String?
  phone              String?
  addressLine1       String?
  addressLine2       String?
  addressLine3       String?
  city               String?
  state              String?
  postcode           String?
  country            String?
  fullAddress        String?  @db.Text
  isDefaultBilling   Boolean  @default(true)
  isDefaultDelivery  Boolean  @default(false)
  sourceRowReference String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, label])
  @@index([customerId, addressType])
}

model SalesDocumentIntake {
  id                String    @id @default(uuid())
  fileName          String
  r2ObjectKey       String    @unique
  mimeType          String
  fileSize          Int
  fileHash          String?
  status            String    @default("UPLOADED")
  documentType      String?
  extractedData     Json?
  validationIssues  Json?
  aiModel           String?
  aiProcessedAt     DateTime?
  errorMessage      String?   @db.Text
  matchedCustomerId String?
  uploadedById      String
  reviewedById      String?
  reviewedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  matchedCustomer Customer?   @relation(fields: [matchedCustomerId], references: [id], onDelete: SetNull)
  uploadedBy      User        @relation("SalesDocumentUploader", fields: [uploadedById], references: [id])
  reviewedBy      User?       @relation("SalesDocumentReviewer", fields: [reviewedById], references: [id])
  salesOrder      SalesOrder?

  @@index([status, createdAt])
  @@index([matchedCustomerId])
  @@index([fileHash])
}

model SalesOrder {
  id                      String    @id @default(uuid())
  internalSoNo            String    @unique
  sageSalesOrderNo        String?
  sourceDocumentId        String?   @unique
  customerId              String
  status                  String    @default("DRAFT")
  documentType            String?
  customerDocumentNo      String?
  poNumber                String?
  orderDate               DateTime? @db.Date
  requestedDeliveryDate   DateTime? @db.Date
  paymentTermsSnapshot    String?
  billingAddressSnapshot  Json?
  deliveryAddressSnapshot Json?
  deliveryContactSnapshot String?
  deliveryPhoneSnapshot   String?
  currency                String    @default("MYR")
  subtotal                Decimal   @default(0) @db.Decimal(14, 2)
  discountTotal           Decimal   @default(0) @db.Decimal(14, 2)
  freightTotal            Decimal   @default(0) @db.Decimal(14, 2)
  taxTotal                Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal              Decimal   @default(0) @db.Decimal(14, 2)
  orderRemarks            String?   @db.Text
  createdById             String
  submittedToWarehouseAt  DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  customer       Customer             @relation(fields: [customerId], references: [id])
  sourceDocument SalesDocumentIntake? @relation(fields: [sourceDocumentId], references: [id], onDelete: SetNull)
  createdBy      User                 @relation("SalesOrderCreator", fields: [createdById], references: [id])
  items          SalesOrderLineItem[]

  @@index([customerId, createdAt])
  @@index([status, createdAt])
  @@index([poNumber])
}

model SalesOrderLineItem {
  id                  String  @id @default(uuid())
  salesOrderId        String
  sku                 String?
  itemCodeSnapshot    String?
  barcodeSnapshot     String?
  descriptionSnapshot String
  uom                 String  @default("CTN")
  qtyOrdered          Decimal @db.Decimal(14, 3)
  qtyAllocated        Decimal @default(0) @db.Decimal(14, 3)
  qtyDelivered        Decimal @default(0) @db.Decimal(14, 3)
  unitPrice           Decimal @default(0) @db.Decimal(14, 4)
  discountAmount      Decimal @default(0) @db.Decimal(14, 2)
  taxAmount           Decimal @default(0) @db.Decimal(14, 2)
  lineTotal           Decimal @default(0) @db.Decimal(14, 2)
  isServiceCharge     Boolean @default(false)
  remarks             String?

  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)

  @@index([salesOrderId])
  @@index([sku])
}

// PO-SOA checks are deliberately separate from SalesDocumentIntake so a review
// retains both original PDFs and its finance decision as one audit record.
model CreditCheckCase {
  id                  String    @id @default(uuid())
  poFileName          String
  poR2ObjectKey       String    @unique
  soaFileName         String
  soaR2ObjectKey      String    @unique
  status              String    @default("UPLOADED")
  recommendation      String?
  poData              Json?
  soaData             Json?
  result              Json?
  justification       String?   @db.Text
  financeRemarks      String?   @db.Text
  financeEvidenceUrl  String?
  financeEvidenceName String?
  bdFollowUpRemarks   String?   @db.Text
  finalDecision       String?
  decidedById         String?
  decidedAt           DateTime?
  uploadedById        String
  aiModel             String?
  errorMessage        String?   @db.Text
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([recommendation, createdAt])
}
