generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                  @id @default(uuid())
  name              String
  email             String                  @unique
  password          String
  role              Role                    @default(STAFF)
  branchId          String?
  unitId            String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  modules           String[]                @default([])
  googleEmail       String?
  dailyReports      DailyReport[]           @relation("DailyReportCreator")
  createdDOs        DistributionOrder[]     @relation("DOCreator")
  assignedEvents    Event[]                 @relation("EventAssignee")
  events            Event[]                 @relation("EventCreator")
  eventInvites      EventAttendee[]
  notices           Notice[]
  receivedTransfers ProductionTransfer[]    @relation("TransferReceiver")
  
  // Handover Relations
  createdHandovers  ProductionHandover[]    @relation("HandoverCreator")
  receivedHandovers ProductionHandover[]    @relation("HandoverReceiver")
  
  assignedTickets   Ticket[]                @relation("TicketAssignee")
  tickets           Ticket[]                @relation("TicketCreator")
  branch            Branch?                 @relation(fields: [branchId], references: [id])
  unit              Unit?                   @relation(fields: [unitId], references: [id])
  openingStocks     WarehouseOpeningStock[] @relation("OpeningStockSetter")
  auditLogs         AuditLog[]
  assetAssignments  AssetAssignment[]
  createdReminders  Reminder[]              @relation("ReminderCreator")
  reminderTargets   ReminderRecipient[]     @relation("ReminderTargetUser")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]
  users     User[]
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tickets   Ticket[]
  branch    Branch   @relation(fields: [branchId], references: [id])
  users     User[]
  reminders Reminder[]
}

enum AssetStatus {
  AVAILABLE
  ASSIGNED
  MAINTENANCE
  RETIRED
}

enum AssetType {
  IT_EQUIPMENT
  VEHICLE
  MACHINERY
  FURNITURE
  SAFETY
  OTHER
  // New standardized categories
  ICT_EQUIPMENT
  OFFICE_EQUIPMENT
  EVENT_EQUIPMENT
  TOOLS
  SAFETY_EQUIPMENT
  MACHINE
  ELECTRICAL_EQUIPMENT
}

model Department {
  id        String   @id @default(uuid())
  name      String   @unique
  code      String?  @unique
  assets    Asset[]
}

model Location {
  id        String   @id @default(uuid())
  name      String
  block     String?
  state     String?
  city      String?
  assets    Asset[]
}

model Asset {
  id             String      @id @default(uuid())
  assetTag       String      @unique
  name           String
  brand          String?
  model          String?
  serialNumber   String?
  deviceId       String?
  description    String?     @db.Text
  
  type           AssetType   @default(OTHER)
  status         AssetStatus @default(AVAILABLE)
  
  purchaseDate   DateTime?   @db.Date
  price          Float?
  supplier       String?
  warrantyInfo   String?
  
  plateNumber    String?
  
  departmentId   String?
  department     Department? @relation(fields: [departmentId], references: [id])
  
  locationId     String?
  location       Location?   @relation(fields: [locationId], references: [id])
  
  assignments    AssetAssignment[]
  maintenance    MaintenanceLog[]
  tickets        Ticket[]
  
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model AssetAssignment {
  id             String    @id @default(uuid())
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  userId         String
  user           User      @relation(fields: [userId], references: [id])
  
  checkoutDate   DateTime  @default(now())
  returnDate     DateTime?
  remarks        String?
}

model MaintenanceLog {
  id             String    @id @default(uuid())
  assetId        String
  asset          Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)
  
  date           DateTime  @default(now())
  cost           Float?
  vendor         String?
  description    String
  resolution     String?
}

model Ticket {
  id            String       @id @default(uuid())
  title         String
  description   String
  status        TicketStatus @default(OPEN)
  priority      String       @default("Low")
  createdById   String
  unitId        String?
  location      String?
  linkedAssetId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assetNumber   String?
  assetType     String?
  assigneeId    String?
  internalNotes String?
  phone         String?
  resolution    String?
  rootCause     String?
  requesterName String?
  ticketNumber  Int          @unique @default(autoincrement())
  slaBreached   Boolean      @default(false)
  slaDeadline   DateTime?
  type          String?
  typeOthers    String?
  assignee      User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy     User         @relation("TicketCreator", fields: [createdById], references: [id])
  linkedAsset   Asset?       @relation(fields: [linkedAssetId], references: [id])
  unit          Unit?        @relation(fields: [unitId], references: [id])
  costs         TicketCost[]
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  startDateTime DateTime
  endDateTime   DateTime
  assigneeId    String?
  createdById   String
  googleEventId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignee      User?    @relation("EventAssignee", fields: [assigneeId], references: [id])
  createdBy     User     @relation("EventCreator", fields: [createdById], references: [id])
  attendees     EventAttendee[]
}

model EventAttendee {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  status    String   @default("PENDING") // PENDING | GOING | MAYBE | DECLINED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
}

model TransferIn {
  id           String           @id @default(uuid())
  receiveDate  DateTime         @db.Date
  receiveTime  String
  shift        String           @default("AM")
  doNumber     String
  receiverName String
  createdAt    DateTime         @default(now())
  items        TransferInItem[]
}

model TransferInItem {
  id           String     @id @default(uuid())
  transferInId String
  category     String
  batchNo      String
  bags         Int
  mult         Int
  transferIn   TransferIn @relation(fields: [transferInId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                  String               @id @default(uuid())
  date                DateTime             @db.Date
  shift               String
  line                String
  preparedBy          String
  verifiedBy          String
  remarks             String?
  createdAt           DateTime             @default(now())
  status              String               @default("PENDING")
  noProduction        Boolean              @default(false)
  preparedSignature   String?
  verifiedSignature   String?
  time                String?
  reportTime          String?
  approvedAt          DateTime?
  createdById         String?
  totalManpower       Int?
  maxTotalManpower    Int?
  breakdowns          BreakdownLog[]
  createdBy           User?                @relation("DailyReportCreator", fields: [createdById], references: [id])
  inventory           InventoryLog[]
  productions         ProductionOutput[]
  productionTransfers ProductionTransfer[]
  productionHandovers ProductionHandover[]
  rejects             RejectLog[]
  holds               ProductionHoldItem[]
}

model ProductionHoldItem {
  id             String       @id @default(uuid())
  reportId       String
  sectionKey     String
  batchNo        String
  qty            Float
  mult           Int          @default(1)
  reason         String
  status         String       @default("PENDING") // PENDING, REJECT_BEFORE, REJECT_AFTER, REUSE, RETURN
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  resolvedAt     DateTime?
  report         DailyReport  @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionOutput {
  id          String            @id @default(uuid())
  reportId    String
  productType String
  totalBox    Int
  batches     ProductionBatch[]
  report      DailyReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionBatch {
  id                 String           @id @default(uuid())
  productionOutputId String
  batchNo            String
  qty                Int
  type               String
  otherType          String?
  productionOutput   ProductionOutput @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)
}

model RejectLog {
  id       String      @id @default(uuid())
  reportId String
  item     String
  before   Int
  after    Int
  type     String      @default("SCRAP")
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model BreakdownLog {
  id       String      @id @default(uuid())
  reportId String
  section  String
  downtime Int
  reason   String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  type       String
  period     String?
  batchNo    String
  bags       Float
  mult       Int
  labelType  String?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CostCatalog {
  id          String   @id @default(uuid())
  itemName    String
  description String?
  defaultCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketCost {
  id        String   @id @default(uuid())
  ticketId  String
  itemName  String
  amount    Float
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notice {
  id             String   @id @default(uuid())
  message        String
  type           String   @default("NORMAL")
  targetAudience String   @default("ALL")
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation(fields: [createdById], references: [id])
}

model ProductionTransfer {
  id            String         @id @default(uuid())
  dailyReportId String?
  sku           String
  batchNumber   String
  qtyProduced   Int
  status        TransferStatus @default(PENDING)
  receivedById  String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dailyReport   DailyReport?   @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  receivedBy    User?          @relation("TransferReceiver", fields: [receivedById], references: [id])
}

model ProductionHandover {
  id                 String   @id @default(uuid())
  handoverNumber     String   @unique
  date               DateTime
  
  dailyReportId      String
  dailyReport        DailyReport @relation(fields: [dailyReportId], references: [id], onDelete: Cascade)
  
  productionStaffId  String
  productionStaff    User     @relation("HandoverCreator", fields: [productionStaffId], references: [id])
  productionSign     String?  // Digital signature of production staff
  
  warehouseStaffId   String?  // Nullable until signed
  warehouseStaff     User?    @relation("HandoverReceiver", fields: [warehouseStaffId], references: [id])
  warehouseSign      String?  // Digital signature of warehouse staff
  
  status             String   @default("PENDING") // PENDING, ACKNOWLEDGED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              HandoverItem[]
}

model HandoverItem {
  id                 String   @id @default(uuid())
  handoverId         String
  category           String
  batchNo            String
  type               String   @default("Standard")
  totalProducedPcs   Int
  
  // Deductions
  deductions         HandoverDeduction[]

  // Final to warehouse
  netToWarehousePcs  Int

  handover           ProductionHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model HandoverDeduction {
  id                 String   @id @default(uuid())
  handoverItemId     String
  destination        String   // e.g. "Budak Tahfiz", "Staff Purchase"
  qtyPcs             Int
  remarks            String?

  handoverItem       HandoverItem @relation(fields: [handoverItemId], references: [id], onDelete: Cascade)
}

model InventoryBatch {
  id               String   @id @default(uuid())
  batchNumber      String
  sku              String
  totalQtyIn       Int      @default(0)
  totalQtyOut      Int      @default(0)
  availableBalance Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([sku, batchNumber])
}

model DistributionOrder {
  id                 String            @id @default(uuid())
  doNumber           String            @unique
  distributionDate   DateTime
  destination        String
  vehicleNo          String?
  driverName         String?
  status             DOStatus          @default(PREPARING)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sponsorshipDetails String?
  distributionMethod String
  items              DOLineItem[]
  createdBy          User              @relation("DOCreator", fields: [createdById], references: [id])
  returns            GoodsReturnNote[]
}

model DOLineItem {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtySent             Int
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model GoodsReturnNote {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtyReturned         Int
  reason              ReturnReason
  status              ReturnStatus      @default(QUARANTINE)
  loggedAt            DateTime          @default(now())
  restockedAt         DateTime?
  restockedBy         String?
  restockedSignature  String?
  restockedReason     String?
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model WarehouseOpeningStock {
  id          String   @id @default(uuid())
  batchNumber String
  sku         String
  openingQty  Int
  month       Int
  year        Int
  setById     String
  createdAt   DateTime @default(now())
  setBy       User     @relation("OpeningStockSetter", fields: [setById], references: [id])

  @@unique([sku, batchNumber, month, year])
}

enum Role {
  SUPERADMIN
  STAFF
  SUPERVISOR
}

enum Status {
  ACTIVE
  BROKEN
  MAINTENANCE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TransferStatus {
  PENDING
  RECEIVED
}

enum DOStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ReturnReason {
  DAMAGE
  WRONG_PO
  DELIVERY_FAIL
}

enum ReturnStatus {
  QUARANTINE
  SCRAP
  REPACKED
  RESTOCKED
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  userName  String
  action    String
  details   String?  @db.Text
  createdAt DateTime @default(now())

  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}

// ==========================================
// MAINTENANCE FORMS MODELS
// ==========================================

model MaintenanceLighting {
  id                 String   @id @default(uuid())
  date               DateTime
  coverageArea       String
  results            String
  action             String?
  performedBy        String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceFinishedGoods {
  id                 String   @id @default(uuid())
  date               DateTime
  qtyDamage425x24    Int      @default(0)
  qtyDamage425x6     Int      @default(0)
  qtyDamage800x12    Int      @default(0)
  qtyDamage800x20    Int      @default(0)
  actionTaken        String?
  performedBy        String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceWasteManagement {
  id                 String   @id @default(uuid())
  date               DateTime
  
  // RECYCLE
  recyclePlasticBottle String?
  recycleCap           String?
  recycleCartonBox     String?
  recycleLabel         String?
  recycleOthers        String?
  
  // DISPOSAL
  disposalPlasticBottle String?
  disposalCap           String?
  disposalCartonBox     String?
  disposalLabel         String?
  disposalOthers        String?

  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceWasteDisposal {
  id                 String   @id @default(uuid())
  date               DateTime
  inspectionTime     String
  feederArea         Boolean  @default(false)
  labelArea          Boolean  @default(false)
  fillingArea        Boolean  @default(false)
  packagingArea      Boolean  @default(false)
  changingRoom       Boolean  @default(false)
  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceFoodHandler {
  id                 String   @id @default(uuid())
  date               DateTime
  employeeName       String
  hairnet            Boolean  @default(false)
  facemask           Boolean  @default(false)
  cleanUniform       Boolean  @default(false)
  shoes              Boolean  @default(false)
  glove              Boolean  @default(false)
  fingernails        Boolean  @default(false)
  noJewellery        Boolean  @default(false)
  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceChemical {
  id                 String   @id @default(uuid())
  date               DateTime
  chemicalCode       String
  timeTaken          String
  takenBy            String
  performedSignature String?
  timeReturn         String?
  returnBy           String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceCleaning {
  id                 String   @id @default(uuid())
  date               DateTime
  shift              String   // AM (Sesi Pagi) | PM (Sesi Petang)
  section            String   // meeting-changing | filtration-uv | labelling | raw-material | packing | machine-3in1 | finishing | blower-buffer | auto-scrambler
  line               String?  // Line 1 | Line 2 (null for meeting-changing and filtration-uv)
  
  // Cleaner type & quantity
  floorCleaner       String?
  platformCleaner    String?
  trashCleaner       String?
  mirrorCleaner      String?
  ceilingCleaner     String?
  machineCleaner     String?
  shutterCleaner     String?

  // Checklist values
  floorOk            Boolean  @default(false)
  platformOk         Boolean  @default(false)
  trashOk            Boolean  @default(false)
  mirrorOk           Boolean  @default(false)
  ceilingOk          Boolean  @default(false)
  machineOk          Boolean  @default(false)
  shutterOk          Boolean  @default(false)

  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceItem {
  id          String                  @id @default(uuid())
  name        String
  location    String                  @default("Pedas")
  quantity    Int                     @default(0)
  unit        String                  @default("pcs")
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  logs        MaintenanceStockLog[]

  @@unique([name, location])
}

model MaintenanceStockLog {
  id          String           @id @default(uuid())
  itemId      String
  item        MaintenanceItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String           // IN | OUT
  quantity    Int
  handledBy   String
  remarks     String?
  createdAt   DateTime         @default(now())
}

model MaintenanceEquipmentRecord {
  id                 String   @id @default(uuid())
  date               DateTime
  activities         Json     
  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  remarks            String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenancePreventiveInspection {
  id                 String   @id @default(uuid())
  date               DateTime
  time               String
  
  autoScrambler      Boolean  @default(false)
  threeInOne         Boolean  @default(false)
  blower             Boolean  @default(false)
  label              Boolean  @default(false)
  printer            Boolean  @default(false)
  steamGenerator     Boolean  @default(false)
  weighing           Boolean  @default(false)
  sealer             Boolean  @default(false)
  roboticArm         Boolean  @default(false)
  wrapping           Boolean  @default(false)
  sandFilter         Boolean  @default(false)
  carbonFilter       Boolean  @default(false)
  hollowMembrane     Boolean  @default(false)
  uvMachine          Boolean  @default(false)
  airCompressor      Boolean  @default(false)
  rawWaterPump       Boolean  @default(false)
  rawTank            Boolean  @default(false)
  filteredTank       Boolean  @default(false)
  well               Boolean  @default(false)
  
  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenancePreventiveRecord {
  id                 String   @id @default(uuid())
  date               DateTime
  line               String   
  
  autoScrambler      Boolean  @default(false)
  threeInOne         Boolean  @default(false)
  blower             Boolean  @default(false)
  label              Boolean  @default(false)
  laserPrinting      Boolean  @default(false)
  weighing           Boolean  @default(false)
  sealer             Boolean  @default(false)
  roboticArm         Boolean  @default(false)
  wrapping           Boolean  @default(false)
  sandFilter         Boolean  @default(false)
  carbonFilter       Boolean  @default(false)
  hollowMembrane     Boolean  @default(false)
  uvMachine          Boolean  @default(false)
  airCompressor      Boolean  @default(false)
  rawWaterPump       Boolean  @default(false)
  rawTank            Boolean  @default(false)
  filteredTank       Boolean  @default(false)

  checkedBy          String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model MaintenanceFiltrationBackwash {
  id                 String   @id @default(uuid())
  date               DateTime
  
  quartzStart        String?
  quartzStop         String?
  
  carbonStart        String?
  carbonStop         String?
  
  membraneStart      String?
  membraneStop       String?
  
  doneBy             String
  performedSignature String?
  verifiedBy         String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


// ==========================================
// PRODUCTION FORMS MODELS
// ==========================================

model ProductionLightingFixture {
  id                 String   @id @default(uuid())
  date               DateTime
  cleaningLocation   String
  activityPerformed  String
  condition          String   // GOOD | NOT_GOOD
  nextCourseOfAction String?
  supervisedBy       String
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionGlassLog {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  inspectionArea     String
  conditionOfGlass   String
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionGlassBreakage {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  areaOfInterest     String
  causedBy           String
  nextCourseOfAction String?
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionWoodLog {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  inspectionArea     String
  conditionOfWood    String
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionWoodBreakage {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  areaOfInterest     String
  causedBy           String
  nextCourseOfAction String?
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionPlasticLog {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  inspectionArea     String
  conditionOfPlastic String
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ProductionPlasticBreakage {
  id                 String   @id @default(uuid())
  inspectionMonth    String
  areaOfInterest     String
  causedBy           String
  nextCourseOfAction String?
  remarks            String?
  checkedBy          String
  verifiedBy         String?
  performedSignature String?
  verifiedSignature  String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}


// ============================================================
// Reminder Calendar (scheduled email reminders)
// ============================================================

enum ReminderFrequency {
  ONCE
  DAILY
  WEEKLY
  MONTHLY
}

model Reminder {
  id            String            @id @default(uuid())
  title         String
  description   String?           @db.Text
  category      String            @default("general")
  frequency     ReminderFrequency @default(ONCE)
  onceAt        DateTime?
  timeOfDay     String?
  daysOfWeek    Int[]             @default([])
  dayOfMonth    Int?
  enabled       Boolean           @default(true)
  targetSelf    Boolean           @default(true)
  targetUnitId  String?
  targetModules String[]          @default([])
  actionLinks   Json?
  seedKey       String?           @unique
  createdById   String
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  targetUnit    Unit?             @relation(fields: [targetUnitId], references: [id], onDelete: SetNull)
  createdBy     User              @relation("ReminderCreator", fields: [createdById], references: [id], onDelete: Cascade)
  recipients    ReminderRecipient[]
  deliveries    ReminderDelivery[]

  @@index([enabled, frequency])
}

model ReminderRecipient {
  id         String   @id @default(uuid())
  reminderId String
  userId     String
  createdAt  DateTime @default(now())
  reminder   Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  user       User     @relation("ReminderTargetUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([reminderId, userId])
}

model ReminderDelivery {
  id             String   @id @default(uuid())
  reminderId     String
  occurrenceKey  String
  status         String   @default("SENDING") // SENDING | SENT | PARTIAL | FAILED | SKIPPED_EMPTY
  recipientCount Int      @default(0)
  detail         String?  @db.Text
  sentAt         DateTime @default(now())
  reminder       Reminder @relation(fields: [reminderId], references: [id], onDelete: Cascade)

  @@unique([reminderId, occurrenceKey])
  @@index([reminderId, sentAt])
}

// ==========================================
// SECURITY FORMS MODELS
