# Gemini AI
GEMINI_API_KEY=your-gemini-api-key

# NextAuth / Session Secret & Invalidation Version
NEXTAUTH_SECRET=your-super-secret-key-for-nextauth-replace-me-in-production
# Change/bump AUTH_SESSION_VERSION to force logout all active user sessions instantly across the entire system
AUTH_SESSION_VERSION=v2_force_logout_20261111

