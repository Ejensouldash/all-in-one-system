model MaintenancePurchaseRequest {
  id                    String                           @id @default(uuid())
  prNumber              String                           @unique // PR-YYYY-XXXX
  company               String                           @default("BUBBLES O2 SDN BHD")
  department            String                           @default("MAINTENANCE / ENGINEERING")
  dateRequired          DateTime
  status                String                           @default("PENDING_APPROVAL") // PENDING_APPROVAL, APPROVED, REJECTED, ORDERED, RECEIVED, DAMAGED_OR_WRONG_ITEM, CANCELLED
  ticketId              String?
  ticket                MaintenanceTicket?               @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  
  // Box 1: Requester Details & Signature
  requesterName         String
  requesterDepartment   String                           @default("MAINTENANCE")
  requesterSignature    String?                          @db.Text
  requesterSignedAt     DateTime?                        @default(now())
  
  // Box 2: Approval Details & Signature
  approvedByName        String?
  approverDepartment    String?
  approverSignature     String?                          @db.Text
  approvedAt            DateTime?
  approvalRemarks       String?
  
  // Delivery Tracking (Requirement 1 & 2)
  estimatedDeliveryDate DateTime?
  deliveryRemarks       String?                          @db.Text
  deliveryUpdatedByName String?
  deliveryUpdatedAt     DateTime?
  
  // Box 3: Receiving Details & Photo Proof (Requirement 8 & 9)
  receivedByName        String?
  receiverDepartment    String?
  receiverSignature     String?                          @db.Text
  receivedAt            DateTime?
  receivedPhotoUrl      String?
  
  // Damage / Discrepancy Reporting
  damageReportReason    String?                          @db.Text
  damageReportPhotoUrl  String?
  damageReportedByName  String?
  damageReportedAt      DateTime?
  
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt

  items                 MaintenancePurchaseRequestItem[]
  activityLogs          MaintenancePurchaseRequestLog[]

  @@index([status])
  @@index([prNumber])
  @@index([ticketId])
}

