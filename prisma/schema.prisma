generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                String                  @id @default(uuid())
  name              String
  email             String                  @unique
  password          String
  role              Role                    @default(STAFF)
  branchId          String?
  unitId            String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  modules           String[]                @default([])
  dailyReports      DailyReport[]           @relation("DailyReportCreator")
  createdDOs        DistributionOrder[]     @relation("DOCreator")
  assignedEvents    Event[]                 @relation("EventAssignee")
  events            Event[]                 @relation("EventCreator")
  notices           Notice[]
  receivedTransfers ProductionTransfer[]    @relation("TransferReceiver")
  
  // Handover Relations
  createdHandovers  ProductionHandover[]    @relation("HandoverCreator")
  receivedHandovers ProductionHandover[]    @relation("HandoverReceiver")
  
  assignedTickets   Ticket[]                @relation("TicketAssignee")
  tickets           Ticket[]                @relation("TicketCreator")
  branch            Branch?                 @relation(fields: [branchId], references: [id])
  unit              Unit?                   @relation(fields: [unitId], references: [id])
  openingStocks     WarehouseOpeningStock[] @relation("OpeningStockSetter")
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  location  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units     Unit[]
  users     User[]
}

model Unit {
  id        String   @id @default(uuid())
  name      String
  branchId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  assets    Asset[]
  tickets   Ticket[]
  branch    Branch   @relation(fields: [branchId], references: [id])
  users     User[]
}

model Asset {
  id           String     @id @default(uuid())
  serialNumber String?
  status       Status     @default(ACTIVE)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  barcode      String?
  brand        String
  category     String
  location     String?
  model        String
  unitId       String?
  assigneeName String?
  unit         Unit?      @relation(fields: [unitId], references: [id])
  logs         AssetLog[]
  tickets      Ticket[]
}

model AssetLog {
  id          String   @id @default(uuid())
  assetId     String
  action      String
  description String
  performedBy String?
  date        DateTime @default(now())
  asset       Asset    @relation(fields: [assetId], references: [id], onDelete: Cascade)
}

model Ticket {
  id            String       @id @default(uuid())
  title         String
  description   String
  status        TicketStatus @default(OPEN)
  priority      String       @default("Low")
  createdById   String
  unitId        String?
  linkedAssetId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  assetNumber   String?
  assetType     String?
  assigneeId    String?
  internalNotes String?
  phone         String?
  resolution    String?
  rootCause     String?
  requesterName String?
  ticketNumber  Int          @unique @default(autoincrement())
  slaBreached   Boolean      @default(false)
  slaDeadline   DateTime?
  type          String?
  typeOthers    String?
  assignee      User?        @relation("TicketAssignee", fields: [assigneeId], references: [id])
  createdBy     User         @relation("TicketCreator", fields: [createdById], references: [id])
  linkedAsset   Asset?       @relation(fields: [linkedAssetId], references: [id])
  unit          Unit?        @relation(fields: [unitId], references: [id])
  costs         TicketCost[]
}

model Event {
  id            String   @id @default(uuid())
  title         String
  description   String?
  startDateTime DateTime
  endDateTime   DateTime
  assigneeId    String?
  createdById   String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  assignee      User?    @relation("EventAssignee", fields: [assigneeId], references: [id])
  createdBy     User     @relation("EventCreator", fields: [createdById], references: [id])
}

model TransferIn {
  id           String           @id @default(uuid())
  receiveDate  DateTime         @db.Date
  receiveTime  String
  doNumber     String
  receiverName String
  createdAt    DateTime         @default(now())
  items        TransferInItem[]
}

model TransferInItem {
  id           String     @id @default(uuid())
  transferInId String
  category     String
  batchNo      String
  bags         Int
  mult         Int
  transferIn   TransferIn @relation(fields: [transferInId], references: [id], onDelete: Cascade)
}

model DailyReport {
  id                  String               @id @default(uuid())
  date                DateTime             @db.Date
  shift               String
  line                String
  preparedBy          String
  verifiedBy          String
  remarks             String?
  createdAt           DateTime             @default(now())
  status              String               @default("PENDING")
  preparedSignature   String?
  verifiedSignature   String?
  time                String?
  approvedAt          DateTime?
  createdById         String?
  totalManpower       Int?
  maxTotalManpower    Int?
  breakdowns          BreakdownLog[]
  createdBy           User?                @relation("DailyReportCreator", fields: [createdById], references: [id])
  inventory           InventoryLog[]
  productions         ProductionOutput[]
  productionTransfers ProductionTransfer[]
  productionHandovers ProductionHandover[]
  rejects             RejectLog[]
}

model ProductionOutput {
  id          String            @id @default(uuid())
  reportId    String
  productType String
  totalBox    Int
  batches     ProductionBatch[]
  report      DailyReport       @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model ProductionBatch {
  id                 String           @id @default(uuid())
  productionOutputId String
  batchNo            String
  qty                Int
  type               String
  otherType          String?
  productionOutput   ProductionOutput @relation(fields: [productionOutputId], references: [id], onDelete: Cascade)
}

model RejectLog {
  id       String      @id @default(uuid())
  reportId String
  item     String
  before   Int
  after    Int
  type     String      @default("SCRAP")
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model BreakdownLog {
  id       String      @id @default(uuid())
  reportId String
  section  String
  downtime Int
  reason   String
  report   DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model InventoryLog {
  id         String      @id @default(uuid())
  reportId   String
  sectionKey String
  type       String
  period     String?
  batchNo    String
  bags       Float
  mult       Int
  labelType  String?
  report     DailyReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model CostCatalog {
  id          String   @id @default(uuid())
  itemName    String
  description String?
  defaultCost Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TicketCost {
  id        String   @id @default(uuid())
  ticketId  String
  itemName  String
  amount    Float
  createdAt DateTime @default(now())
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
}

model Notice {
  id             String   @id @default(uuid())
  message        String
  type           String   @default("NORMAL")
  targetAudience String   @default("ALL")
  isActive       Boolean  @default(true)
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      User     @relation(fields: [createdById], references: [id])
}

model ProductionTransfer {
  id            String         @id @default(uuid())
  dailyReportId String?
  sku           String
  batchNumber   String
  qtyProduced   Int
  status        TransferStatus @default(PENDING)
  receivedById  String?
  receivedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  dailyReport   DailyReport?   @relation(fields: [dailyReportId], references: [id])
  receivedBy    User?          @relation("TransferReceiver", fields: [receivedById], references: [id])
}

model ProductionHandover {
  id                 String   @id @default(uuid())
  handoverNumber     String   @unique
  date               DateTime
  
  dailyReportId      String
  dailyReport        DailyReport @relation(fields: [dailyReportId], references: [id])
  
  productionStaffId  String
  productionStaff    User     @relation("HandoverCreator", fields: [productionStaffId], references: [id])
  productionSign     String?  // Digital signature of production staff
  
  warehouseStaffId   String?  // Nullable until signed
  warehouseStaff     User?    @relation("HandoverReceiver", fields: [warehouseStaffId], references: [id])
  warehouseSign      String?  // Digital signature of warehouse staff
  
  status             String   @default("PENDING") // PENDING, ACKNOWLEDGED
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  items              HandoverItem[]
}

model HandoverItem {
  id                 String   @id @default(uuid())
  handoverId         String
  category           String
  batchNo            String
  type               String   @default("Standard")
  totalProducedPcs   Int
  
  // Deductions
  deductions         HandoverDeduction[]

  // Final to warehouse
  netToWarehousePcs  Int

  handover           ProductionHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
}

model HandoverDeduction {
  id                 String   @id @default(uuid())
  handoverItemId     String
  destination        String   // e.g. "Budak Tahfiz", "Staff Purchase"
  qtyPcs             Int
  remarks            String?

  handoverItem       HandoverItem @relation(fields: [handoverItemId], references: [id], onDelete: Cascade)
}

model InventoryBatch {
  id               String   @id @default(uuid())
  batchNumber      String   @unique
  sku              String
  totalQtyIn       Int      @default(0)
  totalQtyOut      Int      @default(0)
  availableBalance Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model DistributionOrder {
  id                 String            @id @default(uuid())
  doNumber           String            @unique
  distributionDate   DateTime
  destination        String
  vehicleNo          String?
  driverName         String?
  status             DOStatus          @default(PREPARING)
  createdById        String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  sponsorshipDetails String?
  distributionMethod String
  items              DOLineItem[]
  createdBy          User              @relation("DOCreator", fields: [createdById], references: [id])
  returns            GoodsReturnNote[]
}

model DOLineItem {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtySent             Int
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model GoodsReturnNote {
  id                  String            @id @default(uuid())
  distributionOrderId String
  sku                 String
  batchNumber         String
  qtyReturned         Int
  reason              ReturnReason
  status              ReturnStatus      @default(QUARANTINE)
  loggedAt            DateTime          @default(now())
  restockedAt         DateTime?
  restockedBy         String?
  restockedSignature  String?
  restockedReason     String?
  distributionOrder   DistributionOrder @relation(fields: [distributionOrderId], references: [id], onDelete: Cascade)
}

model WarehouseOpeningStock {
  id          String   @id @default(uuid())
  batchNumber String
  sku         String
  openingQty  Int
  month       Int
  year        Int
  setById     String
  createdAt   DateTime @default(now())
  setBy       User     @relation("OpeningStockSetter", fields: [setById], references: [id])

  @@unique([batchNumber, month, year])
}

enum Role {
  SUPERADMIN
  STAFF
  SUPERVISOR
}

enum Status {
  ACTIVE
  BROKEN
  MAINTENANCE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

enum TransferStatus {
  PENDING
  RECEIVED
}

enum DOStatus {
  PREPARING
  SHIPPED
  DELIVERED
  RETURNED
}

enum ReturnReason {
  DAMAGE
  WRONG_PO
  DELIVERY_FAIL
}

enum ReturnStatus {
  QUARANTINE
  SCRAP
  REPACKED
  RESTOCKED
}
